# Copy this file to `.env` and fill in real values. The file is gitignored.
# docker-compose.yml reads these at startup; values default to dev-safe.

# ─── ML service (Hugging Face for pyannote) ──────────────────────────────────
# Each developer creates their own token at huggingface.co/settings/tokens —
# do NOT commit a real token to git. The fallback below is intentionally bogus
# so a misconfigured machine fails loudly rather than silently using someone
# else's quota.
HF_TOKEN=hf_PUT_YOUR_TOKEN_HERE

# Whisper transcription model size. Trade-off:
#   tiny / base   — fast, ~1 GB RAM, lower accuracy; good for dev
#   small         — middle ground
#   medium        — default; ~5 GB RAM, real ASR quality
#   large         — best accuracy, ~10 GB RAM
WHISPER_MODEL=small

# ─── Public Intelligence Enrichment ──────────────────────────────────────────
# Picks the implementation in Backend/enrichment_providers/.
#   wikidata — free, no auth, queries https://www.wikidata.org and SPARQL
#   null     — feature disabled; enrichment endpoints return 503
ENRICHMENT_PROVIDER=wikidata

# ─── Cloud state (optional) ──────────────────────────────────────────────────
# When unset, Backend uses local SQLite + on-disk uploads (single-machine).
# Set both blocks below to share state across all 3 dev machines via free-tier
# Turso (SQLite cloud) + Cloudflare R2 (S3-compatible audio storage).

# Turso — create at turso.tech, then `turso db create kollab`
TURSO_URL=
TURSO_AUTH_TOKEN=

# Cloudflare R2 — dashboard.cloudflare.com → R2 → Create bucket "kollab-audio"
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
