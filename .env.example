# Copy this file to `.env` and fill in real values. The file is gitignored.
# docker-compose.yml reads these at startup; values default to dev-safe.

# ─── ML service (Hugging Face for pyannote) ──────────────────────────────────
HF_TOKEN=

# Whisper transcription model size. Trade-off:
#   tiny / base   — fast, ~1 GB RAM, lower accuracy; good for dev
#   small         — middle ground
#   medium        — default; ~5 GB RAM, real ASR quality
#   large         — best accuracy, ~10 GB RAM
WHISPER_MODEL=small

# ─── Public Intelligence Enrichment ──────────────────────────────────────────
# Picks the implementation in Backend/enrichment_providers/.
#   wikidata — free, no auth, queries https://www.wikidata.org and SPARQL
#   null     — feature disabled; enrichment endpoints return 503
ENRICHMENT_PROVIDER=wikidata
